# Crie o .env preenchido SOMENTE no EC2; chmod 600 .env.
DOCKER_NAMESPACE=seu-usuario-dockerhub
# O deploy fornece a tag por commit; operacoes manuais exigem IMAGE_TAG explicita.
POSTGRES_DB=portal_backoffice
POSTGRES_USER=portal_backoffice
# Use openssl rand -hex 32 (hex evita caracteres reservados na DATABASE_URL).
POSTGRES_PASSWORD=TROQUE-ME
# Gere dois valores distintos com openssl rand -hex 48.
JWT_ACCESS_SECRET=TROQUE-ME
JWT_REFRESH_SECRET=TROQUE-ME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Dominio sem protocolo. Vazio permite HTTP pelo IP, usando o mesmo Caddy.
APP_DOMAIN=portal.exemplo.com.br
CORS_ORIGIN=https://portal.exemplo.com.br
# false SOMENTE se estiver acessando por HTTP/IP.
COOKIE_SECURE=true

# true apenas para inicializar a base; depois volte para false.
RUN_SEED=false
ADMIN_EMAIL=admin@exemplo.com.br
ADMIN_NAME=Administrador
# openssl rand -hex 16. O seed de producao nunca redefine usuario existente.
ADMIN_PASSWORD=TROQUE-ME

# Preencha se configurar webhook do Telegram (/api/telegram/webhook).
TELEGRAM_WEBHOOK_SECRET=

# Login com Google. Publique com false, injete o Client ID e habilite depois.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
# Opcional: dominios do Workspace aceitos, separados por virgula, validados
# pelo campo hd do ID token.
GOOGLE_ALLOWED_DOMAINS=
# true cria e vincula a conta no primeiro acesso. Exige GOOGLE_ALLOWED_DOMAINS.
GOOGLE_AUTO_PROVISION=false

# Agenda Google. Publique com false e ligue depois de configurar o consentimento.
# Cada colaborador autoriza a propria conta em Meu perfil > Agenda Google.
GOOGLE_CALENDAR_ENABLED=false
# Segredo do MESMO cliente OAuth do login (aplicativo da Web).
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=
# Cadastre esta URL identica no Google Cloud, com o prefixo /api do Caddy.
GOOGLE_CALENDAR_OAUTH_REDIRECT_URI=https://portal.exemplo.com.br/api/agenda-google/oauth/callback
# 32 bytes aleatorios em base64. Gere uma vez e preserve entre deploys:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
GOOGLE_CALENDAR_TIMEZONE=America/Sao_Paulo
GOOGLE_CALENDAR_ID=primary
# Endereco publico do portal: link dentro do evento e retorno do consentimento.
APP_PUBLIC_URL=https://portal.exemplo.com.br
# O painel usa o mesmo Client ID, gravado no bundle: configure a variavel
# VITE_GOOGLE_CLIENT_ID no repositorio (Actions > Variables), nao aqui.
