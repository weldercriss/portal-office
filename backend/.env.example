DATABASE_URL="postgresql://portal_backoffice:portal_backoffice@localhost:5433/portal_backoffice?schema=public"
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3333
CORS_ORIGIN="http://localhost:5173"
# Segredo do path do webhook (/telegram/webhook/<secret>) que o Telegram chama
# quando alguem manda mensagem pro bot. So numeros/letras, sem barra.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Depois de preencher, registre no Telegram: npm run telegram:set-webhook -- <url-publica-do-backend>
TELEGRAM_WEBHOOK_SECRET=""
# Login com Google: mantenha desabilitado ate concluir os testes.
GOOGLE_AUTH_ENABLED="false"
GOOGLE_CLIENT_ID=""
# Opcional: dominios do Workspace aceitos, validados pelo campo hd do ID token.
# Vazio aceita qualquer conta Google ja vinculada a um usuario do portal.
GOOGLE_ALLOWED_DOMAINS=""
# true cria e vincula a conta no primeiro acesso. Exige GOOGLE_ALLOWED_DOMAINS.
GOOGLE_AUTO_PROVISION="false"
# --- Agenda Google (plantoes na agenda de cada pessoa) ---
# Cada colaborador autoriza a propria conta em Meu perfil > Agenda Google.
# Mantenha desligado ate configurar o cliente OAuth e a chave de criptografia.
GOOGLE_CALENDAR_ENABLED="false"
# Segredo do MESMO cliente OAuth do login (aplicativo da Web). Só no backend.
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=""
# URL publica completa, identica a cadastrada no Google Cloud.
# Producao atras do Caddy: https://SEU-DOMINIO/api/agenda-google/oauth/callback
GOOGLE_CALENDAR_OAUTH_REDIRECT_URI="http://localhost:3333/agenda-google/oauth/callback"
# 32 bytes aleatorios em base64, gerados uma vez por ambiente e preservados
# entre deploys: sem ela os refresh tokens guardados nao abrem mais.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=""
GOOGLE_CALENDAR_TIMEZONE="America/Sao_Paulo"
# "primary" e a agenda principal da pessoa.
GOOGLE_CALENDAR_ID="primary"
# Origem publica do frontend: link dentro do evento e retorno do consentimento.
# Sem valor, cai no CORS_ORIGIN.
APP_PUBLIC_URL="http://localhost:5173"
